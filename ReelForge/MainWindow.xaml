<Window x:Class="ReelForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReelForge Native" Width="1440" Height="900" MinWidth="1000" MinHeight="650"
        Background="#101219" Foreground="#E9EBF2">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10">
      <TextBlock Text="ReelForge" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
      <TextBlock Text="  Native Windows editor • local files only" Foreground="#8A93A8" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Add photos" Click="AddPhotos_Click" Padding="12,7" Margin="5,0"/>
        <Button Content="Add audio" Click="AddAudio_Click" Padding="12,7" Margin="5,0"/>
        <Button Content="Export" Click="Export_Click" Padding="12,7" Margin="5,0"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#171A23" Padding="10" Margin="0,0,8,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Local media library" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ListBox x:Name="MediaList" DisplayMemberPath="Name" SelectionChanged="MediaList_SelectionChanged"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Background="#080A0F" Padding="12" Margin="0,0,8,0">
        <Grid>
          <Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed"/>
          <MediaElement x:Name="AudioPreview" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed"/>
          <TextBlock x:Name="EmptyText" Text="Add an image or audio file from any drive" Foreground="#8A93A8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="#171A23" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Timeline" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ListBox x:Name="TimelineList" DisplayMemberPath="Name"/>
        </DockPanel>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="StatusText" Text="Ready • files stay in their original drive location" Foreground="#8A93A8" Margin="0,10,0,0"/>
  </Grid>
</Window>